// LiGN Phase 2 — §62 entities. Postgres. Stubs (Schedule/JournalEntry/SharedMemory/TrustedPerson) carry no logic in MVP.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountState {
  ACTIVE
  PAUSED
  DELETED
}

enum DiscoveryState {
  DISCOVERABLE
  NOT_DISCOVERABLE
}

enum ConnectionState {
  STRANGER
  CONVERSATION
  MUTUAL_CONNECTION
  ACTIVE
  PAUSED
  ARCHIVED
  ENDED
}

enum SafetyState {
  NORMAL
  FLAGGED
  RESTRICTED
  SUSPENDED
  REMOVED
}

model User {
  id               String         @id @default(cuid())
  nickname         String
  email            String         @unique
  avatarKind       String         @default("none")
  avatarColor      String?
  avatarUrl        String?
  currentNeeds     String[]       @default([])
  language         String?
  // Better Auth fields (adapter-managed; LiGN identity stays nickname-based).
  name             String?
  emailVerified    Boolean        @default(false)
  image            String?
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  accounts         Account[]
  ageRange         String?
  country          String?
  bio              String?
  interests        String[]       @default([])
  accountState     AccountState   @default(ACTIVE)
  discoveryState   DiscoveryState @default(DISCOVERABLE)
  safetyState      SafetyState    @default(NORMAL)
  returnAt         DateTime?
  pendingDeletionAt DateTime?
  verificationData String?
  createdAt        DateTime       @default(now())
  availability     Availability?
}

model Availability {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  types          String[]
  windows        String?
  tempState      String?
  tempStateUntil DateTime?
}

model Connection {
  id          String          @id @default(cuid())
  userAId     String
  userBId     String
  state       ConnectionState @default(STRANGER)
  duration    String?
  pausedAt    DateTime?
  archivedAt  DateTime?
  endedAt     DateTime?
  enderId     String?
  reconnectRule String? // allow | temp-block | permanent-block (ender-controlled)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  conversations Conversation[]
}

model ConnectionRequest {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  note        String?
  state       String   @default("pending") // pending | accepted | declined | ignored
  createdAt   DateTime @default(now())
}

model Conversation {
  id           String     @id @default(cuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  type         String     @default("one-on-one")
  retention    String?
  createdAt    DateTime   @default(now())
  messages     Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  spaceId        String?
  space          TemporarySpace? @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  moderation     String   @default("clear")
  deleted        Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model TemporarySpace {
  id         String   @id @default(cuid())
  creatorId  String
  purpose    String
  durationMin Int
  capacity   Int      @default(8)
  state      String   @default("open") // open | closed | expired
  createdAt  DateTime @default(now())
  closesAt   DateTime
  participants SpaceParticipant[]
  messages     Message[]
}

model SpaceParticipant {
  id      String @id @default(cuid())
  spaceId String
  space   TemporarySpace @relation(fields: [spaceId], references: [id])
  userId  String
  joinedAt DateTime @default(now())
}

model SpaceReconnectWish {
  id       String   @id @default(cuid())
  spaceId  String
  wanterId String
  wantedId String
  createdAt DateTime @default(now())

  @@unique([spaceId, wanterId, wantedId])
}

model Report {
  id        String   @id @default(cuid())
  reporterId String
  targetId  String
  spaceId   String?
  category  String
  evidence  String?
  review    String   @default("pending")
  action    String?
  appeal    String?
  createdAt DateTime @default(now())
}

model Block {
  id        String    @id @default(cuid())
  blockerId String
  blockedId String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([blockerId, blockedId])
}

// Better Auth adapter tables (managed by Better Auth; never edited by hand).
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// MVP stubs — no logic until Phase 10/11
model ListenerQueueEntry {
  id        String   @id @default(cuid())
  userId    String   @unique
  need      String
  createdAt DateTime @default(now())
}

model DeletionFeedback {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  message   String?
  createdAt DateTime @default(now())
}

model Schedule {
  id     String @id @default(cuid())
  data   String?
}

model JournalEntry {
  id     String @id @default(cuid())
  data   String?
}

model SharedMemory {
  id     String @id @default(cuid())
  data   String?
}

model TrustedPerson {
  id     String @id @default(cuid())
  data   String?
}
